{
  "name": "contrail-airline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Contrail — przeglądarkowa gra o budowie sieci połączeń lotniczych",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "build:single": "tsc --noEmit -p . && vite build --mode single --outDir dist-single",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "d3-geo": "^3.1.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
